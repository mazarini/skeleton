{% extends 'base.html.twig' %}

{% block title %}
	{{ user.new ? 'New User' : 'Edit User' }}
{% endblock %}

{% block body %}
	<h1>{{ user.new ? 'Create new User' : 'Edit User' }}</h1>

	{% embed 'user/_form.html.twig' %}
        {% block boutons %}
            <button class="btn">{{ user.new? 'Create' : 'Save' }}</button>
            <a href="{{ path('app_user_index') }}">back to list</a>
        {% endblock %}
    {% endembed %}}

	{% if not user.new %}
		{{ include('user/_delete_form.html.twig') }}
	{% endif %}
{% endblock %}
