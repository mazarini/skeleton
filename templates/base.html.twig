<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>

		<!-- stylesheets -->
		{% block stylesheets %}{% endblock %}
		<!-- /stylesheets -->

		<!-- javascripts -->
		{% block javascripts %}
