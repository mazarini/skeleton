<!DOCTYPE html>
{% block variables %}{% endblock %}
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block head_title %}
				{{ title }}
			{% endblock %}
		</title>
		<!-- stylesheets -->
		{% block stylesheets %}{% endblock %}
		<!-- /stylesheets -->
		<!-- javascripts -->
		{% block javascripts %}
			{% block importmap %}
				{{ importmap(['twbs_bootstrap','app']) }}
			{% endblock %}
		{% endblock %}
		<!-- /javascripts -->
	</head>
	<body id="body" class="{{ bodyClass(app.request) }}">
        {% block body %}{% endblock %}
        {{ dump(bodyClass(app.request)) }}
    </body>
</html>
